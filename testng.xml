<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<!-- suite name="API test Suite" thread-count="2" parallel="tests" -> This 
	is for parallel execution -->

<suite name="API test Suite">

	<listeners>
		<listener class-name="utils.ExtentReporter" />
	</listeners>

	<test name="Product API Test">
		<classes>
			<class name="testcases.ProductTests" />
		</classes>
	</test> <!-- Test -->


	<test name="Users API Test">
		<classes>
			<class name="testcases.UsersTests" />
		</classes>
	</test> <!-- Test -->


	<test name="Cart API Test">
		<classes>
			<class name="testcases.CartTests" />
		</classes>
	</test> <!-- Test -->

	<test name="Login API Test">
		<classes>
			<class name="testcases.LoginTest" />
		</classes>
	</test> <!-- Test -->


	<test name="Schema Test">
		<classes>
			<class name="testcases.SchemaTests" />
		</classes>
	</test> <!-- Test -->

</suite> <!-- Suite -->
